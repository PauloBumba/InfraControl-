    <Output>
      <StdOut>[xUnit.net 00:00:00.00] xUnit.net VSTest Adapter v2.8.2+699d445a1a (64-bit .NET 10.0.12)
[xUnit.net 00:00:00.11]   Discovering: InfraControl.ArchitectureTests
[xUnit.net 00:00:00.25]   Discovered:  InfraControl.ArchitectureTests
[xUnit.net 00:00:00.26]   Starting:    InfraControl.ArchitectureTests
[xUnit.net 00:00:00.68]       Expected source "user  nginx;
[xUnit.net 00:00:00.68]       worker_processes  auto;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]       error_log  /var/log/nginx/error.log warn;
[xUnit.net 00:00:00.68]       pid        /var/run/nginx.pid;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]       events {
[xUnit.net 00:00:00.68]           worker_connections 1024;
[xUnit.net 00:00:00.68]       }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]       http {
[xUnit.net 00:00:00.68]           include       /etc/nginx/mime.types;
[xUnit.net 00:00:00.68]           default_type  application/octet-stream;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           # Upload de evidências do PDI (docs/30 §12): limite do nginx era 1 MB
[xUnit.net 00:00:00.68]           # (default) e devolvia 413 antes de a API validar o teto de 10 MB.
[xUnit.net 00:00:00.68]           # 16 MB deixa folga para o multipart de 10 MB + envelope.
[xUnit.net 00:00:00.68]           client_max_body_size 16m;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           log_format main '$remote_addr - $remote_user [$time_local] "$request" '
[xUnit.net 00:00:00.68]                           '$status $body_bytes_sent $request_time '
[xUnit.net 00:00:00.68]                           '$upstream_addr $upstream_status $upstream_response_time '
[xUnit.net 00:00:00.68]                           '"$http_referer" "$http_user_agent"';
[xUnit.net 00:00:00.68]           access_log /var/log/nginx/access.log main;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           sendfile        on;
[xUnit.net 00:00:00.68]           keepalive_timeout 65;
[xUnit.net 00:00:00.68]           gzip on;
[xUnit.net 00:00:00.68]           gzip_types text/plain text/css application/json application/javascript image/svg+xml;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           # DNS do Docker Compose: necessário porque o serviço `seq` só existe no
[xUnit.net 00:00:00.68]           # profile `obs` — o bloco abaixo usa resolução dinâmica para o nginx não
[xUnit.net 00:00:00.68]           # falhar no boot quando o Seq está desligado (retorna 502 até subir).
[xUnit.net 00:00:00.68]           # ADR-044: mesma resolução dinâmica permite scale horizontal da API
[xUnit.net 00:00:00.68]           # com docker compose --scale api=N (DNS round-robin do Docker).
[xUnit.net 00:00:00.68]           resolver 127.0.0.11 valid=30s ipv6=off;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           # Upstream da API para load balancing (ADR-044)
[xUnit.net 00:00:00.68]           # `resolve` atualiza os endereços do serviço após criar/remover réplicas.
[xUnit.net 00:00:00.68]           # O zone é obrigatório para upstream dinâmico no Nginx OSS 1.27.3+.
[xUnit.net 00:00:00.68]           # keepalive 32 mantém conexões reutilizáveis entre instâncias.
[xUnit.net 00:00:00.68]           upstream api_backend {
[xUnit.net 00:00:00.68]               zone api_backend 64k;
[xUnit.net 00:00:00.68]               server api:8080 resolve max_fails=3 fail_timeout=10s;
[xUnit.net 00:00:00.68]               keepalive 32;
[xUnit.net 00:00:00.68]           }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           # ---- Seq protegido por basic auth (ADR-022) ----------------------------
[xUnit.net 00:00:00.68]           # Rota externa da plataforma de logs. A porta 5341 publicada no host é a
[xUnit.net 00:00:00.68]           # do nginx (auth), NUNCA a do serviço Seq.
[xUnit.net 00:00:00.68]           server {
[xUnit.net 00:00:00.68]               listen 5341;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               auth_basic "InfraControl Seq";
[xUnit.net 00:00:00.68]               auth_basic_user_file /etc/nginx/seq.htpasswd;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               location / {
[xUnit.net 00:00:00.68]                   set $seq_upstream http://seq:80;
[xUnit.net 00:00:00.68]                   proxy_pass $seq_upstream;
[xUnit.net 00:00:00.68]                   proxy_http_version 1.1;
[xUnit.net 00:00:00.68]                   proxy_set_header Host $host;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Proto $scheme;
[xUnit.net 00:00:00.68]               }
[xUnit.net 00:00:00.68]           }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           # ---- App: HTTP -&gt; HTTPS -----------------------------------------------
[xUnit.net 00:00:00.68]           # A porta do redirect NÃO é a da origem ($http_host seria a porta HTTP) e
[xUnit.net 00:00:00.68]           # nem fixa (80→443, 8080→8443, 8085→8445): vem do host por envsubst — o
[xUnit.net 00:00:00.68]           # entrypoint do nginx oficial processa /etc/nginx/templates/*.template e
[xUnit.net 00:00:00.68]           # injeta NGINX_HTTPS_PORT (docker/Dockerfile + docker-compose.yml).
[xUnit.net 00:00:00.68]           # $host já vem sem porta; 443 fica implícito.
[xUnit.net 00:00:00.68]           map "${NGINX_HTTPS_PORT}" $https_port_suffix {
[xUnit.net 00:00:00.68]               "443"   "";
[xUnit.net 00:00:00.68]               default ":${NGINX_HTTPS_PORT}";
[xUnit.net 00:00:00.68]           }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           server {
[xUnit.net 00:00:00.68]               listen 80 default_server;
[xUnit.net 00:00:00.68]               server_name _;
[xUnit.net 00:00:00.68]               return 301 https://$host$https_port_suffix$request_uri;
[xUnit.net 00:00:00.68]           }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]           # ---- App HTTPS (cookie da sessão é Secure; ADR-008/ADR-017) ------------
[xUnit.net 00:00:00.68]           server {
[xUnit.net 00:00:00.68]               listen 443 ssl default_server;
[xUnit.net 00:00:00.68]               server_name _;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               ssl_certificate     /etc/nginx/ssl/server.crt;
[xUnit.net 00:00:00.68]               ssl_certificate_key /etc/nginx/ssl/server.key;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               root  /usr/share/nginx/html;
[xUnit.net 00:00:00.68]               index index.html;
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               # Health checks da API: ficam na RAIZ (/health, /health/ready, ...)
[xUnit.net 00:00:00.68]               # em Program.cs. A página de saúde da SPA mudou para /status justamente
[xUnit.net 00:00:00.68]               # para estes caminhos não colidirem — sem os locations abaixo,
[xUnit.net 00:00:00.68]               # GET https://host/health caía no try_files e devolvia o index.html.
[xUnit.net 00:00:00.68]               # ADR-044: usa upstream api_backend para load balancing entre réplicas.
[xUnit.net 00:00:00.68]               location = /health {
[xUnit.net 00:00:00.68]                   proxy_pass http://api_backend;
[xUnit.net 00:00:00.68]                   proxy_http_version 1.1;
[xUnit.net 00:00:00.68]                   proxy_set_header Connection "";
[xUnit.net 00:00:00.68]                   proxy_set_header Host $host;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Proto https;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Host $http_host;
[xUnit.net 00:00:00.68]               }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               location /health/ {
[xUnit.net 00:00:00.68]                   proxy_pass http://api_backend;
[xUnit.net 00:00:00.68]                   proxy_http_version 1.1;
[xUnit.net 00:00:00.68]                   proxy_set_header Connection "";
[xUnit.net 00:00:00.68]                   proxy_set_header Host $host;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Proto https;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Host $http_host;
[xUnit.net 00:00:00.68]               }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               # API: pass-through sem reescrita — o backend já serve em /api/v1/...
[xUnit.net 00:00:00.68]               # (mesma origem elimina o CORS; ADR-022). ADR-044: usa upstream
[xUnit.net 00:00:00.68]               # api_backend para load balancing entre réplicas da API.
[xUnit.net 00:00:00.68]               # Sem a barra no final: "location /api/" não casa "/api" e a
[xUnit.net 00:00:00.68]               # requisição caía no SPA devolvendo HTML onde esperava-se JSON.
[xUnit.net 00:00:00.68]               location /api {
[xUnit.net 00:00:00.68]                   proxy_pass http://api_backend;
[xUnit.net 00:00:00.68]                   proxy_http_version 1.1;
[xUnit.net 00:00:00.68]                   proxy_set_header Connection "";
[xUnit.net 00:00:00.68]                   proxy_set_header Host $host;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Proto https;
[xUnit.net 00:00:00.68]                   proxy_set_header X-Forwarded-Host $http_host;
[xUnit.net 00:00:00.68]               }
[xUnit.net 00:00:00.68]       
[xUnit.net 00:00:00.68]               # SignalR (/hubs) precisa de Upgrade para WebSocket.
[xUnit.net 00:00:00.69]               # ADR-044: usa upstream api_backend. Como configuramos Redis backplane,
[xUnit.net 00:00:00.69]               # não precisamos de sticky sessions (ip_hash). Com Redis backplane,
[xUnit.net 00:00:00.69]               # qualquer instância pode atender a conexão WebSocket.
[xUnit.net 00:00:00.69]               location /hubs/ {
[xUnit.net 00:00:00.69]                   proxy_set_header Upgrade $http_upgrade;
[xUnit.net 00:00:00.69]                   proxy_set_header Connection "upgrade";
[xUnit.net 00:00:00.69]                   proxy_pass http://api_backend;
[xUnit.net 00:00:00.69]                   proxy_http_version 1.1;
[xUnit.net 00:00:00.69]                   proxy_set_header Host $host;
[xUnit.net 00:00:00.69]                   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
[xUnit.net 00:00:00.69]                   proxy_set_header X-Forwarded-Proto https;
[xUnit.net 00:00:00.69]                   proxy_set_header X-Forwarded-Host $http_host;
[xUnit.net 00:00:00.69]               }
[xUnit.net 00:00:00.69]       
[xUnit.net 00:00:00.69]               # SPA: cai no index.html para o React Router resolver a rota.
[xUnit.net 00:00:00.69]               location / {
[xUnit.net 00:00:00.69]                   try_files $uri $uri/ /index.html;
[xUnit.net 00:00:00.69]               }
[xUnit.net 00:00:00.69]           }
[xUnit.net 00:00:00.69]       }" to contain "http://api:8080".
