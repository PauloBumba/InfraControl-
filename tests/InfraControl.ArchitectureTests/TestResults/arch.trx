    <UnitTestResult executionId="cf93871b-5fa6-45d1-9399-4c5807a3aa0d" testId="1a74d00a-eed6-d7fd-9497-50df5220760e" testName="InfraControl.ArchitectureTests.Rules.RoleAuthorizationStandardizationTests.Controller_Should_Not_Use_Role_Literals(controllerTypeName: &quot;InfraControl.Api.Controllers.Operations.PdiControl&quot;···)" computerName="unifi" duration="00:00:00.0002298" startTime="2026-10-10T23:07:13.0780661-03:00" endTime="2026-10-10T23:07:13.0780662-03:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Passed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="cf93871b-5fa6-45d1-9399-4c5807a3aa0d" />
    <UnitTestResult executionId="c7298992-8cac-4063-9763-868fd31eafc5" testId="71ddbcad-5b8d-270a-399e-95769c2c59d7" testName="InfraControl.ArchitectureTests.Rules.EndpointAlignmentTests.Nginx_Should_Proxy_The_Api_Health_Checks" computerName="unifi" duration="00:00:00.2936071" startTime="2026-10-10T23:07:13.2429646-03:00" endTime="2026-10-10T23:07:13.2429655-03:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Failed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="c7298992-8cac-4063-9763-868fd31eafc5">
      <Output>
        <ErrorInfo>
          <Message>Expected source "user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Upload de evidências do PDI (docs/30 §12): limite do nginx era 1 MB
    # (default) e devolvia 413 antes de a API validar o teto de 10 MB.
    # 16 MB deixa folga para o multipart de 10 MB + envelope.
    client_max_body_size 16m;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent $request_time '
                    '$upstream_addr $upstream_status $upstream_response_time '
                    '"$http_referer" "$http_user_agent"';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    keepalive_timeout 65;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # DNS do Docker Compose: necessário porque o serviço `seq` só existe no
    # profile `obs` — o bloco abaixo usa resolução dinâmica para o nginx não
    # falhar no boot quando o Seq está desligado (retorna 502 até subir).
    # ADR-044: mesma resolução dinâmica permite scale horizontal da API
    # com docker compose --scale api=N (DNS round-robin do Docker).
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Upstream da API para load balancing (ADR-044)
    # `resolve` atualiza os endereços do serviço após criar/remover réplicas.
    # O zone é obrigatório para upstream dinâmico no Nginx OSS 1.27.3+.
    # keepalive 32 mantém conexões reutilizáveis entre instâncias.
    upstream api_backend {
        zone api_backend 64k;
        server api:8080 resolve max_fails=3 fail_timeout=10s;
        keepalive 32;
    }

    # ---- Seq protegido por basic auth (ADR-022) ----------------------------
    # Rota externa da plataforma de logs. A porta 5341 publicada no host é a
    # do nginx (auth), NUNCA a do serviço Seq.
    server {
        listen 5341;

        auth_basic "InfraControl Seq";
        auth_basic_user_file /etc/nginx/seq.htpasswd;

        location / {
            set $seq_upstream http://seq:80;
            proxy_pass $seq_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # ---- App: HTTP -&gt; HTTPS -----------------------------------------------
    # A porta do redirect NÃO é a da origem ($http_host seria a porta HTTP) e
    # nem fixa (80→443, 8080→8443, 8085→8445): vem do host por envsubst — o
    # entrypoint do nginx oficial processa /etc/nginx/templates/*.template e
    # injeta NGINX_HTTPS_PORT (docker/Dockerfile + docker-compose.yml).
    # $host já vem sem porta; 443 fica implícito.
    map "${NGINX_HTTPS_PORT}" $https_port_suffix {
        "443"   "";
        default ":${NGINX_HTTPS_PORT}";
    }

    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$https_port_suffix$request_uri;
    }

    # ---- App HTTPS (cookie da sessão é Secure; ADR-008/ADR-017) ------------
    server {
        listen 443 ssl default_server;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

        root  /usr/share/nginx/html;
        index index.html;

        # Health checks da API: ficam na RAIZ (/health, /health/ready, ...)
        # em Program.cs. A página de saúde da SPA mudou para /status justamente
        # para estes caminhos não colidirem — sem os locations abaixo,
        # GET https://host/health caía no try_files e devolvia o index.html.
        # ADR-044: usa upstream api_backend para load balancing entre réplicas.
        location = /health {
            proxy_pass http://api_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $http_host;
        }

        location /health/ {
            proxy_pass http://api_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $http_host;
        }

        # API: pass-through sem reescrita — o backend já serve em /api/v1/...
        # (mesma origem elimina o CORS; ADR-022). ADR-044: usa upstream
        # api_backend para load balancing entre réplicas da API.
        # Sem a barra no final: "location /api/" não casa "/api" e a
        # requisição caía no SPA devolvendo HTML onde esperava-se JSON.
        location /api {
            proxy_pass http://api_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $http_host;
        }

        # SignalR (/hubs) precisa de Upgrade para WebSocket.
        # ADR-044: usa upstream api_backend. Como configuramos Redis backplane,
        # não precisamos de sticky sessions (ip_hash). Com Redis backplane,
        # qualquer instância pode atender a conexão WebSocket.
        location /hubs/ {
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_pass http://api_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $http_host;
        }

        # SPA: cai no index.html para o React Router resolver a rota.
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}" to contain "http://api:8080".</Message>
