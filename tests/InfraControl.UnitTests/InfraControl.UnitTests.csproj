<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Policies HTTP de permissão (PermissionPolicyTests) — tipos de ASP.NET Core. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <!-- F0-T019: fixa a versão corrigida do SQLitePCLRaw (transitivo do EF Core
         Sqlite). A 2.1.11 traz NU1903 (GHSA-2m69-gcr7-jv3q); a 2.1.13 fecha.
         Afeta apenas dev/teste — não entra no runtime da API (PostgreSQL). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Suíte inteira usa as mesmas 4 bases (assert/contexto Sqlite) —
         registradas aqui para os testes nascerem sem boilerplate (Fase 1). -->
    <Using Include="FluentAssertions" />
    <Using Include="Microsoft.EntityFrameworkCore" />
    <Using Include="Microsoft.Data.Sqlite" />
    <Using Include="InfraControl.Infrastructure.Persistence" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfraControl.Domain\InfraControl.Domain.csproj" />
    <ProjectReference Include="..\..\src\InfraControl.Application\InfraControl.Application.csproj" />
    <ProjectReference Include="..\..\src\InfraControl.Contracts\InfraControl.Contracts.csproj" />
    <ProjectReference Include="..\..\src\InfraControl.Infrastructure\InfraControl.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\InfraControl.Api\InfraControl.Api.csproj" />
    <ProjectReference Include="..\..\src\InfraControl.Workers\InfraControl.Workers.csproj" />
  </ItemGroup>

</Project>
