<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\InfraControl.Domain\InfraControl.Domain.csproj" />
    <ProjectReference Include="..\InfraControl.BuildingBlocks\InfraControl.BuildingBlocks.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <!-- Pipeline transversal do CQRS — registrado no projeto para não poluir
       cada arquivo de slice com os mesmos using (Fase 1 global usings). -->
  <ItemGroup>
    <Using Include="MediatR" />
    <Using Include="InfraControl.BuildingBlocks.Application" />
    <Using Include="InfraControl.Application.Common.Interfaces" />
    <Using Include="InfraControl.Domain.Authorization" />
  </ItemGroup>

</Project>
