{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "InfraControl.Workers"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=infracontrol;Username=infracontrol;Password=infracontrol_dev_2026",
    "Redis": "localhost:6379",
    "RabbitMQ": "localhost"
  },
  "RabbitMQ": {
    "User": "infracontrol",
    "Password": "infracontrol_dev_2026"
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalSeconds": 5
  },
  "Performance": {
    "SlowRequestMs": 1000
  },
  "Retention": {
    "OutboxProcessedDays": 30,
    "ProcessedMessagesDays": 30,
    "AuditEntriesDays": 90,
    "MonitoringResultsDays": 180,
    "NotificationsDays": 90,
    "RemoteSessionsDays": 90,
    "DiscoveryRunsDays": 180,
    "MonitoringEventsDays": 90,
    "InvitationsDays": 90,
    "BatchSize": 500
  },
  "Backup": {
    "Enabled": true,
    "IntervalHours": 24,
    "RetentionDays": 7,
    "Path": "backups",
    "FileNamePrefix": "infracontrol",
    "TimeoutSeconds": 3600
  },
  "Cleanup": {
    "Enabled": true,
    "IntervalHours": 24
  },
  "MonitoringPolling": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "Monitoring": {
    "Snmp": {
      "Community": "public",
      "Port": 161
    }
  },
  "Notifications": {
    "Channels": {
      "Default": [ "Email", "SignalR" ],
      "Telegram": { "ChatId": "" },
      "WhatsApp": { "Phone": "" },
        "Webhook": { "Url": "" },
        "Slack": { "Channel": "" }
    }
  },
  "Ai": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434"
    },
    "Routing": {
      "Copilot": {
        "DefaultModel": "qwen2.5-coder:1.5b",
        "FallbackModel": null
      },
      "IncidentAnalysis": {
        "DefaultModel": "qwen2.5-coder:1.5b",
        "FallbackModel": null
      },
      "KnowledgeGeneration": {
        "DefaultModel": "qwen2.5-coder:1.5b",
        "FallbackModel": null
      },
      "Reporting": {
        "DefaultModel": "qwen2.5-coder:1.5b",
        "FallbackModel": null
      },
      "Automation": {
        "DefaultModel": "qwen2.5-coder:1.5b",
        "FallbackModel": null
      }
    }
  }
}
