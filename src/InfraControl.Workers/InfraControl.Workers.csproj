<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-InfraControl.Workers-c006846c-8bf7-4a31-b124-416c59dc00b7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />

    <!-- ADR-021: sem Serilog aqui o log do worker não sai do container. -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfraControl.Application\InfraControl.Application.csproj" />
    <ProjectReference Include="..\InfraControl.Infrastructure\InfraControl.Infrastructure.csproj" />
    <ProjectReference Include="..\InfraControl.Contracts\InfraControl.Contracts.csproj" />
  </ItemGroup>
</Project>
