{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "InfraControl.Api"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "InfraControl.Api",
    "Endpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=infracontrol;Username=infracontrol;Password=infracontrol_dev_2026",
    "Redis": "localhost:6379",
    "RabbitMQ": "localhost"
  },
  "RabbitMQ": {
    "User": "infracontrol",
    "Password": "infracontrol_dev_2026"
  },
  "FeatureFlags": {
    "DiscoveryEnabled": false,
    "MonitoringEnabled": false,
    "McpEnabled": false
  },
  "Resilience": {
    "DefaultTimeoutSeconds": 10,
    "DefaultMaxRetries": 3,
    "DefaultFailureThreshold": 5,
    "DefaultBreakDurationSeconds": 30
  },
  "Retention": {
    "OutboxProcessedDays": 30,
    "ProcessedMessagesDays": 30,
    "AuditEntriesDays": 90,
    "BatchSize": 500
  },
  "Monitoring": {
    "Snmp": {
      "Community": "public",
      "Port": 161
    }
  }
}
