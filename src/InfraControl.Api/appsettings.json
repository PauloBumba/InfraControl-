{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "InfraControl.Api"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "InfraControl.Api",
    "Endpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=infracontrol;Username=infracontrol;Password=infracontrol_dev_2026",
    "Redis": "localhost:6379",
    "RabbitMQ": "localhost"
  },
  "RabbitMQ": {
    "User": "infracontrol",
    "Password": "infracontrol_dev_2026"
  },
  "FeatureFlags": {
    "DiscoveryEnabled": false,
    "MonitoringEnabled": false,
    "McpEnabled": false
  },
  "Resilience": {
    "DefaultTimeoutSeconds": 10,
    "DefaultMaxRetries": 3,
    "DefaultFailureThreshold": 5,
    "DefaultBreakDurationSeconds": 30
  },
  "Performance": {
    "SlowRequestMs": 1000
  },
  "Mfa": {
    "ToleranceSteps": 1
  },
  "Retention": {
    "OutboxProcessedDays": 30,
    "ProcessedMessagesDays": 30,
    "AuditEntriesDays": 90,
    "MonitoringResultsDays": 180,
    "NotificationsDays": 90,
    "RemoteSessionsDays": 90,
    "DiscoveryRunsDays": 180,
    "BatchSize": 500
  },
  "RateLimit": {
    "Enabled": true,
    "Rules": {
      "Default": { "PermitLimit": 120, "WindowSeconds": 60 },
      "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
      "PasswordReset": { "PermitLimit": 3, "WindowSeconds": 600 },
      "Webhook": { "PermitLimit": 120, "WindowSeconds": 60 },
      "Ingestion": { "PermitLimit": 1000, "WindowSeconds": 60 }
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "AllowedDomains": []
    }
  },
  "Monitoring": {
    "Snmp": {
      "Community": "public",
      "Port": 161
    }
  },
  "RemoteAccess": {
    "CredentialEncryption": {
      "Key": ""
    },
    "Ssh": {
      "Username": "",
      "Password": "",
      "Port": 22,
      "TimeoutSeconds": 10
    },
    "Rdp": {
      "Port": 3389,
      "TimeoutSeconds": 10
    }
  }
}
