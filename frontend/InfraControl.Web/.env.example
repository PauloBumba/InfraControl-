# Frontend (Vite) — copie para .env.local NESTA pasta (o Vite só lê env do
# diretório do projeto, não da raiz do repositório).
#
# Client ID público do Google (Google Cloud Console > APIs e serviços > Credenciais).
# É o MESMO valor de Authentication__Google__ClientId no backend. VITE_* é
# embutido no bundle no build: nunca coloque Client Secret aqui.
VITE_GOOGLE_CLIENT_ID=

# Opcional: URL base da API. Vazio = "/api/v1" (mesma origem, com o proxy do
# Vite em dev apontando para http://localhost:5000). Só use se a API estiver
# em outra origem/porta e o CORS estiver liberado no backend.
VITE_API_BASE_URL=
