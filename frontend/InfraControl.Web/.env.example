# Frontend (Vite) — copie para .env.local NESTA pasta (o Vite só lê env do
# diretório do projeto, não da raiz do repositório).
#
# Client ID público do Google (Google Cloud Console > APIs e serviços > Credenciais).
# É o MESMO valor de Authentication__Google__ClientId no backend. VITE_* é
# embutido no bundle no build: nunca coloque Client Secret aqui.
VITE_GOOGLE_CLIENT_ID=

# Opcional: URL base da API. Vazio = "/api/v1" (mesma origem, com o proxy do
# Vite em dev). Só use se a API estiver em outra origem/porta e o CORS estiver
# liberado no backend.
VITE_API_BASE_URL=

# Opcional (só dev): alvo do proxy do Vite. O cookie de sessão é Secure, então
# o padrão é o perfil https do backend (dotnet dev-certs https --trust).
# VITE_DEV_API_TARGET=https://localhost:7237

# Plataforma de rastreio (ADR-021/022): URL do Seq atrás do nginx.
# Padrão = host local, porta do nginx com basic auth;
# sobrescreva no build em produção/homologação.
VITE_LOGS_URL=http://localhost:5341
