# ==============================================================================
# InfraControl — Template de Configuração de Produção (.env.production.example)
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env no servidor de produção:
#      cp .env.production.example .env
# 2. Restrinja as permissões de leitura imediatamente:
#      chmod 600 .env
# 3. Preencha TODOS os campos obrigatórios abaixo com segredos reais e fortes.
# 4. Valide a configuração antes do deploy executando:
#      ./scripts/deploy/preflight-check.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Imagens Docker Versionadas (ADR-044)
# ------------------------------------------------------------------------------
# NUNCA utilize :latest em produção. Utilize tags imutáveis geradas pelo CI/build.
API_IMAGE=ghcr.io/seu-org/infracontrol-api:v1.0.0
WORKERS_IMAGE=ghcr.io/seu-org/infracontrol-workers:v1.0.0
FRONTEND_IMAGE=ghcr.io/seu-org/infracontrol-frontend:v1.0.0

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL Principal
# ------------------------------------------------------------------------------
POSTGRES_DB=infracontrol
POSTGRES_USER=infracontrol_app
# Senha forte (mínimo 16 caracteres recomendados, com maiúsculas, minúsculas, dígitos e símbolos):
POSTGRES_PASSWORD=Defina_Uma_Senha_Muito_Forte_Postgres_2026!
# Limite máximo de conexões por réplica da aplicação:
POSTGRES_MAX_POOL_SIZE=20
# max_connections do servidor Postgres — mantenha réplicas × pool abaixo deste
# valor com folga para migrations/backup/administração (docs/40):
POSTGRES_MAX_CONNECTIONS=200

# ------------------------------------------------------------------------------
# 3. Redis e Redis Sentinel (ADR-045 Alta Disponibilidade)
# ------------------------------------------------------------------------------
# O segredo do Redis DEVE ser URL-safe (apenas letras A-Z, a-z, números 0-9, "_" e "-")
# para total compatibilidade com o protocolo do Sentinel. Mínimo 16 caracteres.
# Gere com: openssl rand -base64 24 | tr '+/' '_-' | tr -d '='
REDIS_PASSWORD=Defina_Um_Segredo_Forte_UrlSafe_Redis_2026

# Subnet estática dedicada para failover determinístico do Sentinel
INFRACONTROL_NETWORK_SUBNET=172.30.240.0/24
INFRACONTROL_DYNAMIC_IP_RANGE=172.30.240.128/25
REDIS_MASTER_IP=172.30.240.10
REDIS_SLAVE_IP=172.30.240.11
REDIS_SENTINEL_1_IP=172.30.240.12
REDIS_SENTINEL_2_IP=172.30.240.13
REDIS_SENTINEL_3_IP=172.30.240.14

# ------------------------------------------------------------------------------
# 4. Mensageria RabbitMQ
# ------------------------------------------------------------------------------
RABBITMQ_USER=infracontrol_mq
RABBITMQ_PASSWORD=Defina_Uma_Senha_Muito_Forte_RabbitMQ_2026!

# ------------------------------------------------------------------------------
# 5. Certificados TLS e Portas do Nginx
# ------------------------------------------------------------------------------
# Caminhos ABSOLUTOS no host para os arquivos de certificado e chave privada.
# O Nginx irá montá-los como somente leitura.
TLS_CERT_FILE=/etc/ssl/infracontrol/fullchain.pem
TLS_KEY_FILE=/etc/ssl/infracontrol/privkey.pem

# Portas públicas de binding no host (80 e 443 recomendadas em produção):
HTTP_PORT=80
HTTPS_PORT=443

# Autenticação HTTP básica para acesso ao Seq (logs centralizados)
SEQ_AUTH_USER=secops
SEQ_AUTH_PASSWORD=Defina_Uma_Senha_Forte_Para_Seq_2026!

# URL externa para exibição do link de logs no dashboard:
VITE_LOGS_URL=https://infracontrol.suaempresa.com.br/logs

# ------------------------------------------------------------------------------
# 6. Limites de Recursos de CPU e Memória por Container (Docker Deploy Limits)
# ------------------------------------------------------------------------------
# Ajuste conforme o dimensionamento do seu hardware físico / VM.
API_CPUS=2.0
API_MEMORY=2048M

WORKERS_CPUS=1.5
WORKERS_MEMORY=1536M

FRONTEND_CPUS=1.0
FRONTEND_MEMORY=512M

POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2048M

REDIS_CPUS=1.0
REDIS_MEMORY=1024M

REDIS_SENTINEL_CPUS=0.5
REDIS_SENTINEL_MEMORY=256M

RABBITMQ_CPUS=1.0
RABBITMQ_MEMORY=1024M

# ------------------------------------------------------------------------------
# 7. Administrador Inicial (Bootstrap Admin — Somente Primeiro Deploy)
# ------------------------------------------------------------------------------
# Após o primeiro boot e a criação do admin no banco, recomenda-se desativar (false).
PRODUCTION_BOOTSTRAP_ADMIN_ENABLED=true
PRODUCTION_BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.com.br
PRODUCTION_BOOTSTRAP_ADMIN_PASSWORD=Defina_Uma_Senha_Admin_Forte_2026!

# ------------------------------------------------------------------------------
# 8. Flags de Integridade (OBRIGATORIAMENTE FALSE EM PRODUÇÃO)
# ------------------------------------------------------------------------------
MOCK_DATA_ENABLED=false
MOCK_DATA_PURGE=false

# ------------------------------------------------------------------------------
# 9. Integrações Opcionais de Produção
# ------------------------------------------------------------------------------

# Zabbix Webhook Action Token (exigido se Zabbix disparar webhooks para a API)
ZABBIX_TOKEN=

# WhatsApp via Evolution API (Profile evolution — ADR-059)
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_LOG_LEVEL=WARN

# Provedores de IA (Ollama local embarcado via profile `ai` ou chaves externas)
OLLAMA_BASE_URL=http://ollama-lb
OLLAMA_MODEL=qwen2.5-coder:1.5b
OPENAI_API_KEY=
GEMINI_API_KEY=

# F43/ADR-064 — login Google (authorization code com callback no backend).
# Sem os 3 o GET /auth/google responde 503 e o botão some da UI.
# Redirect URI idêntica às "Authorized redirect URIs" do Console do Google.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<host>/api/v1/auth/google/callback
