# InfraControl - Environment Variables

# PostgreSQL
POSTGRES_DB=infracontrol
POSTGRES_USER=infracontrol
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (ADR-045: master + replica + 3 sentinels)
# Troque este valor no .env real. Em produção, use segredo forte URL-safe
# (somente letras, números, "_" e "-") para compatibilidade com Sentinel.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_url_safe_secret
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_2_PORT=26380
REDIS_SENTINEL_3_PORT=26381
# Endereçamento estável para failover Sentinel mesmo quando o container do
# primary é removido da rede. Confirme que a subnet não conflita com LAN, VPN
# ou outras redes Docker no host antes de usar; os IPs Redis/Sentinel devem ser
# únicos, pertencer à subnet e ficar fora do pool dinâmico.
INFRACONTROL_NETWORK_SUBNET=172.30.240.0/24
INFRACONTROL_DYNAMIC_IP_RANGE=172.30.240.128/25
REDIS_MASTER_IP=172.30.240.10
REDIS_SLAVE_IP=172.30.240.11
REDIS_SENTINEL_1_IP=172.30.240.12
REDIS_SENTINEL_2_IP=172.30.240.13
REDIS_SENTINEL_3_IP=172.30.240.14
# O Compose configura ConnectionStrings__Redis com estes três sentinels
# automaticamente. Fora do Compose, mantenha localhost:6379 (standalone)
# ou configure os endpoints Sentinel e serviceName=mymaster na connection string.

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=infracontrol
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_MANAGEMENT_PORT=15672

# Bootstrap Admin (superadmin inicial — opt-in, idempotente; senha só via env/secret)
# A senha tem de cumprir a política do Identity (12+, maiúscula, minúscula,
# dígito e não-alfanumérico): fora dela o bootstrap derruba o boot da API.
BootstrapAdmin__Enabled=true
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__DisplayName=InfraControl Admin
BootstrapAdmin__Password=Change_Me_In_Production_2026

# ---- Fase 0: Integração Zabbix (ADR-023/ADR-027) --------------------------
# Token de action webhook exigido por POST /api/v1/integrations/zabbix/problems
# (allowlist configurável; vazio = endpoint devolve 401). Repassado ao container
# via compose (Integrations__Zabbix__Token).
ZABBIX_TOKEN=

# ---- F20-T001: Integração UniFi Controller (ADR-028 §2) ---------------------
# Cliente REST de saída (login com detecção de estilo: UniFi OS usa
# POST /api/auth/login + prefixo /proxy/network; standalone usa POST /api/login
# com a API na raiz — docs/35 §3). Vazio = integração desligada; sem controller
# em dev nada é chamado. Repassado ao container via compose (Integrations__Unifi__*).
UNIFI_BASE_URL=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
# Fase 1: aceita certificado TLS self-signed do controlador (docs/35 §2).
# true só em dev/teste; manter false (default) em produção.
UNIFI_ALLOW_INVALID_TLS=false

# SNMP (checks SnmpToner/SnmpDrum/SnmpSystem + discovery) — comunidade/porta
# usadas por todos os providers SNMP. Comunidade é segredo de baixo nível:
# em produção troque de "public" e restrinja no dispositivo.
SNMP_COMMUNITY=public
SNMP_PORT=161

# Serviços de rede em leitura (F18-T005/ADR-042): leases/ARP + rotas via SNMP
# (reusam SNMP_COMMUNITY acima) e regras de firewall via SSH por vendor
# (v1: cisco — "show access-lists"). Target vazio = desligado: os endpoints
# /network/services/* respondem 503 com o motivo. Credencial de serviço SSH
# só via env, nunca no repositório.
NETWORK_SERVICES_TARGET=
NETWORK_SERVICES_VENDOR=cisco
NETWORK_SERVICES_SSH_USER=
NETWORK_SERVICES_SSH_PASSWORD=
NETWORK_SERVICES_SSH_PORT=22
NETWORK_SERVICES_TIMEOUT_SECONDS=5

# ---- Notificações (Notifications:Channels) --------------------------------
# Default: canais sempre ativos, separados por índice (0, 1, ...).
NOTIFY_DEFAULT_0=Email
NOTIFY_DEFAULT_1=SignalR
# Canais opcionais — vazios = canal desativado.
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE=
WEBHOOK_URL=
# F19-T007/ADR-028: token enviado no header X-InfraControl-Secret (vazio = sem header).
WEBHOOK_SECRET=
SLACK_CHANNEL=

# ---- F33: Canal WhatsApp via Evolution API (ADR-059, profile `evolution`) --
# Transporte dos eventos do Zabbix para o grupo de WhatsApp da empresa.
# Sobe a infra com: docker compose --profile evolution up -d
# (evolution-api + evolution-db + evolution-redis — portas abaixo).
#
# Passo 1 (uma vez, manual): criar a instância e conectar o QR/pairing code
#   do NÚMERO REMETENTE (decisão do usuário 2026-10-18: número pessoal —
#   risco de banimento registrado no ADR-059 §6; migração para chip
#   dedicado = só trocar a instância, sem mudar código).
# Passo 2: descobrir o JID do grupo "Estudo Arquitetura" e preencher
#   WHATSAPP_GROUP_ID (formato <id>@g.us, ex.: 120363043123456789@g.us).
#
# API key da Evolution (header `apikey` em toda chamada) — exigida também
# pelo dispatcher do InfraControl (mesmo valor). Gere uma forte, ex.:
#   openssl rand -hex 32
EVOLUTION_API_KEY=
# URL da Evolution CONSUMIDA pela API/Workers do InfraControl (dispatcher).
# No compose: http://evolution-api:8080 (DNS interno, nunca localhost);
# fora do Docker: http://localhost:8081. VAZIO = canal WhatsApp fica no
# adaptador de logging (opt-in — ADR-059 §4).
EVOLUTION_BASE_URL=
# Nome da instância WhatsApp criada na Evolution.
# 2026-10-18: instância operacional = "Admin" (criada e conectada pelo usuário
# via manager UI localhost:8081/manager; `bumba`/`infracontrol` foram apagadas
# na interface — 1 número = 1 conexão ativa).
WHATSAPP_INSTANCE=Admin
# Destino GRUPO (prioritário sobre WHATSAPP_PHONE) — formato <id>@g.us.
WHATSAPP_GROUP_ID=
# Portas publicadas no host (profile evolution).
EVOLUTION_API_PORT=8081
EVOLUTION_DB_PORT=5435
EVOLUTION_REDIS_PORT=6380
# Credenciais do banco da Evolution (dev — troque em produção).
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution_dev_password_2026

# Login social Google (F1-T014) — opcional; sem ClientId o endpoint
# POST /api/v1/auth/google responde 503 e o botão some na UI.
# NÃO existe Client Secret no projeto: o fluxo é Google Identity Services
# (id_token validado no servidor), sem troca de authorization code.
# O ClientId é público por natureza e o mesmo valor vai para o VITE_ abaixo.
Authentication__Google__ClientId=
# Restringe o login a domínios Google Workspace (ex.: empresa.com.br).
# Comentado de propósito: deixar a variável definida e vazia seria inofensivo
# (entradas vazias são ignoradas), mas o exibido abaixo deixa claro o formato.
# Authentication__Google__AllowedDomains__0=empresa.com.br

# Frontend (Vite): mesmo Client ID do Google, exposto no bundle como
# identificador público da aplicação (VITE_* é embutido no build). É o mesmo
# valor usado pelo compose para Authentication__Google__ClientId da API — se
# os dois não baterem, o login Google falha.
VITE_GOOGLE_CLIENT_ID=

# ---- Docker Compose (ADR-022) ---------------------------------------------
# Portas publicadas no host. App: HTTP/HTTPS (cookie Secure exige TLS; o nginx
# usa um certificado autoassinado gerado na imagem — o navegador vai reclamar
# uma vez e precisa aceitar). Seq_UI é o nginx com basic auth, NUNCA o Seq cru.
HTTP_PORT=8080
HTTPS_PORT=8443
SEQ_UI_PORT=5341

# URL da plataforma de logs embutida no bundle do front (botão da LogsPage).
# Em dev/local: http://localhost:<SEQ_UI_PORT>. Em produção: o host público +
# SEQ_UI_PORT, ex. https://logs.suaempresa.com.br — se não definir, o bundle
# usa http://localhost:5341.
VITE_LOGS_URL=http://localhost:5341

# Seq: usuário/senha do basic auth no nginx (caminho de acesso à plataforma
# de logs). Segredo de homologação — mude no .env real.
SEQ_AUTH_USER=admin
SEQ_AUTH_PASSWORD=admin

# Coletor OpenTelemetry (profile obs)
OTLP_PORT=4317

# ---- Zabbix 8.0 Infrastructure (profile zabbix — F18-T001) ---------------
# Portas e credenciais publicadas no host para a infraestrutura Docker do Zabbix.
# Zabbix DB dedicado na porta 5433 (PostgreSQL 17), Zabbix Web na 8085, Zabbix Server na 10051 e Agent na 10050.
ZABBIX_DB_PORT=5434
ZABBIX_DB_PASSWORD=zabbix_dev_password_2026
ZABBIX_SERVER_PORT=10052
ZABBIX_WEB_PORT=8086
ZABBIX_AGENT_PORT=10053

# ---- Fase AI — Ollama (ADR-041, profile `ai`) ------------------------------
# Base URL consumida pela API (Ai__Ollama__BaseUrl): dentro do compose é o
# nome do load balancer (http://ollama-lb — nunca localhost entre containers);
# rodando a API fora do Docker, troque para http://localhost:11434.
# NOTA (ADR-057 · FAI-T011a): este valor também alimenta o SEED do
# cadastro de providers no banco (tabela ai_providers) executado no boot
# da API — a linha do Ollama é criada com esta URL. Depois do seed, o
# cadastro (UI Admin → Providers de IA) é a autoridade; mudanças de URL
# posteriores são feitas lá, não aqui.
OLLAMA_BASE_URL=http://ollama-lb
# Porta publicada no host (sobe só com: docker compose --profile ai up -d).
OLLAMA_PORT=11434
# Endereços IP estáveis para as 3 réplicas do Ollama (escala horizontal)
# — conferir que não conflitam com a subnet do compose (INFRACONTROL_NETWORK_SUBNET).
OLLAMA_1_IP=172.30.240.20
OLLAMA_2_IP=172.30.240.21
OLLAMA_3_IP=172.30.240.22
# Modelo LLM padrão (docs/34 §11) — baixado em cada réplica no 1º uso:
#   docker exec infracontrol-ollama-1 ollama pull qwen2.5-coder:1.5b
#   docker exec infracontrol-ollama-2 ollama pull qwen2.5-coder:1.5b
#   docker exec infracontrol-ollama-3 ollama pull qwen2.5-coder:1.5b
OLLAMA_MODEL=qwen2.5-coder:1.5b
# Modelo de embeddings: VAZIO de propósito — a blueprint não define modelo
# de embedding; a escolha é do ADR-038 (S8). Não inventar valor aqui.
OLLAMA_EMBED_MODEL=

# ---- Fase AI — providers externos (ADR-050) ------------------------------
# Chaves de API dos provedores externos: VAZIAS de propósito — o AGENTS.md
# proíbe credenciais reais no repositório. Preencha no seu .env local; vazio
# mantém o provider "não configurado" (§44) e a plataforma segue normal,
# usando o Ollama local (profile `ai`) para as capacidades roteadas.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Roteamento por capacidade em src/InfraControl.Api/appsettings.json
# (Ai:Routing:<Capacidade>:Provider) — ex.: trocar "IncidentAnalysis" para
# "openai" usa a chave acima sem tocar em código.

# ---- Production overlay (docker-compose.production.yml) -------------------
# Campos obrigatórios para um deploy de produção. Dimensione CPU/memória para
# o host e mantenha API replicas × POSTGRES_MAX_POOL_SIZE + workers ×
# POSTGRES_MAX_POOL_SIZE abaixo do max_connections do PostgreSQL, reservando
# conexões para migrations e administração. Use tags de imagem versionadas.
API_IMAGE=
WORKERS_IMAGE=
FRONTEND_IMAGE=
POSTGRES_MAX_POOL_SIZE=20
API_CPUS=
API_MEMORY=
WORKERS_CPUS=
WORKERS_MEMORY=
POSTGRES_CPUS=
POSTGRES_MEMORY=
REDIS_CPUS=
REDIS_MEMORY=
REDIS_SENTINEL_CPUS=
REDIS_SENTINEL_MEMORY=
RABBITMQ_CPUS=
RABBITMQ_MEMORY=
FRONTEND_CPUS=
FRONTEND_MEMORY=
TLS_CERT_FILE=
TLS_KEY_FILE=
# Bootstrap opcional somente no primeiro deploy. Não reutilize o valor dev.
PRODUCTION_BOOTSTRAP_ADMIN_ENABLED=false
PRODUCTION_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PRODUCTION_BOOTSTRAP_ADMIN_PASSWORD=
