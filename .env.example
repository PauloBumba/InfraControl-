# InfraControl - Environment Variables

# PostgreSQL
POSTGRES_DB=infracontrol
POSTGRES_USER=infracontrol
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
